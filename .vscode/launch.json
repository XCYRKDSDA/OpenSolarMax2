{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OpenSolarMax",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build OpenSolarMax.Launcher",
            "program": "${workspaceFolder}/src/OpenSolarMax.Launcher/bin/Debug/net8.0/OpenSolarMax.Launcher.dll",
            "cwd": "${workspaceFolder}",
            "env": {
                "OSM_LEVEL_MOD_PATHS": "levels",
                "OSM_BEHAVIOR_MOD_PATHS": "publish/mods"
            }
        }
    ]
}
