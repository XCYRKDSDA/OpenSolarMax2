{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "publish OpenSolarMax.Mods.Core",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "src/OpenSolarMax.Mods.Core/OpenSolarMax.Mods.Core.csproj",
                "-c",
                "Debug",
                "-o",
                "publish/mods/OpenSolarMax.Mods.Core"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish OpenSolarMax.Mods.S2",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "src/OpenSolarMax.Mods.S2/OpenSolarMax.Mods.S2.csproj",
                "-c",
                "Debug",
                "-o",
                "publish/mods/OpenSolarMax.Mods.S2"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build OpenSolarMax.Launcher",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "src/OpenSolarMax.Launcher/OpenSolarMax.Launcher.csproj",
                "-c",
                "Debug"
            ],
            "dependsOn": [
                "publish OpenSolarMax.Mods.Core",
                "publish OpenSolarMax.Mods.S2"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
